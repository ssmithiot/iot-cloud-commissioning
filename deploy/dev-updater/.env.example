# IOT Edge Development Updater - example configuration
#
# Copy your existing working updater .env to:
#
#     C:\ProgramData\IOT\EdgeDevUpdater\.env
#
# The variable names below are the same ones the existing updater uses, so an
# existing file can be copied across without rewriting it. This example file
# contains no real values and is the only .env-shaped file shipped in the MSI.
#
# Values are never displayed in the interface and never written to the logs.
# Only the variable NAMES appear in a "configuration incomplete" message.

# --- required -----------------------------------------------------------------

# Password for the Cradlepoint jump host (the SSH hop in front of the gateway).
CRADLEPOINT_PASSWORD=

# Password for the gateway account reached through the Cradlepoint.
GATEWAY_PASSWORD=

# --- optional -----------------------------------------------------------------

# Cloud admin token. Only needed if you turn on cloud job claiming, which is OFF
# by default in the Development Updater - see IOT_EDGE_DEV_UPDATER_CLAIM_CLOUD_JOBS
# below. Leave blank for normal manual use.
IOT_ADMIN_API_TOKEN=

# Edge UI login password, used by the post-update UI authentication check.
EDGE_UI_PASSWORD=

# --- optional overrides -------------------------------------------------------
# All have working defaults; set them only if your site differs.

# SSH usernames. Defaults: BMS_admin (Cradlepoint), swadmin (gateway).
#CRADLEPOINT_USER=BMS_admin
#GATEWAY_USER=swadmin

# Edge UI login name used by the post-update check. Default: admin
#EDGE_UI_USERNAME=admin

# --- Development-Updater-specific ---------------------------------------------
# These names exist only in this product, so adding them here cannot affect the
# existing updater's .env format.

# Port for this application. Default 8791. The existing updater uses 8766 and
# this application refuses to bind that port.
#IOT_EDGE_DEV_UPDATER_PORT=8791

# Configuration and log directory. Default C:\ProgramData\IOT\EdgeDevUpdater
#IOT_EDGE_DEV_UPDATER_DATA=

# Unattended cloud job claiming. OFF by default and intended to stay off: this
# is a manual tool, and a second updater claiming queued jobs would compete with
# the existing updater for the same work. Set to 1 only if you specifically want
# this application polling the cloud for queued gateway updates.
#IOT_EDGE_DEV_UPDATER_CLAIM_CLOUD_JOBS=0
